{
  "name": "mus-de-pedania",
  "private": true,
  "version": "0.1.0",
  "description": "Remake-homenaje jugable de los simuladores de mus de bar de mediados de los 90.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "partida": "tsx scripts/partida.ts",
    "voices:manifest": "tsx scripts/voices-manifest.ts",
    "personalidades": "tsx scripts/personalidades.ts",
    "artifact": "npm run build && tsx scripts/artifact.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright": "1.56",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
